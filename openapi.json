  "paths": {
    "/api/login": {
      "post": {
        "summary": "用户登录",
        "description": "用户登录获取JWT Token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                },
                "required": [
                  "username",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功"
          },
          "401": {
            "description": "登录失败"
          }
        }
      }
    },
    "/api/predictions": {
      "get": {
        "summary": "获取预测记录列表",
        "description": "分页获取所有预测记录（管理端）",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10
            }
          },
          {
            "name": "user_id",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功"
          }
        }
      },
      "post": {
        "summary": "添加预测记录",
        "description": "接收用户端预测数据并保存",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "user_id": {
                    "type": "integer"
                  },
                  "all_30_features_json": {
                    "type": "string"
                  },
                  "prediction_result": {
                    "type": "string"
                  },
                  "confidence": {
                    "type": "number"
                  }
                },
                "required": [
                  "user_id",
                  "all_30_features_json",
                  "prediction_result",
                  "confidence"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          }
        }
      }
    },
