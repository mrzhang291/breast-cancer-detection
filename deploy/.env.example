# 环境变量（放到 /opt/breast-cancer-detection/.env，权限 600）

# Flask / session 密钥，务必换成随机串
APP_SECRET_KEY=请替换为随机字符串

# 主站调用管理后台内部接口的共享令牌
INTERNAL_TOKEN=请替换为随机字符串

# 管理后台（5001）JWT / Session 密钥，务必与主站不同
SECRET_KEY=请替换为随机字符串
JWT_SECRET_KEY=请替换为随机字符串

# 大模型开关：auto（探测可用才用）/ off（纯模板）/ api（强制）
AGENT_LLM=auto

# 管理后台只读智能体：auto / off
ADMIN_AGENT_LLM=auto
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Coze 智能体（令牌只放服务端，切勿写入前端页面）
COZE_API_BASE=https://api.coze.cn
COZE_BOT_ID=7697962757626396687
COZE_API_TOKEN=
